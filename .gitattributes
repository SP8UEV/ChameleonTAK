# Skrypty i pliki systemowe trafiają na Linuksa (obraz pi-gen, install.sh) — zawsze LF,
# także przy checkoutcie na Windows. CRLF w skrypcie bash / unicie systemd / sudoers psuje działanie.
*.sh            text eol=lf
*.service       text eol=lf
*.nft           text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

/packaging/**   text eol=lf
/image/**       text eol=lf
/scripts/**     text eol=lf
/.github/**     text eol=lf

# Binarka wkładana do etapu pi-gen przez CI (i tak ignorowana przez .gitignore).
/image/stage-chameleontak/*/files/chameleontak  -text binary
