<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- ChameleonTAK: ogłasza panel WWW przez mDNS/DNS-SD (http://<hostname>.local/). -->
<service-group>
  <name replace-wildcards="yes">ChameleonTAK (%h)</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
